{
  "name": "novus-intelligence-back",
  "version": "0.1.0",
  "private": true,
  "description": "Novus Intelligence backend — Serverless API (Node.js 20 + TypeScript)",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "portal:deploy": "serverless deploy --config serverless-portal.yml",
    "portal:bootstrap": "node scripts/portal/bootstrap-admin.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-codebuild": "^3.758.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.758.0",
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-secrets-manager": "^3.758.0",
    "@aws-sdk/client-ses": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.758.0",
    "@eslint/js": "^9.21.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^20.17.19",
    "eslint": "^9.21.0",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.55.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^2.1.8"
  }
}
